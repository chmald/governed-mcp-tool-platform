FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="1051" width="110" height="44" as="geometry"/></mxCell><mxCell id="r17p" value="GAP" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1347" y="1064" width="36" height="18" as="geometry"/></mxCell><mxCell id="r17n" value="By design in v1 — enforce in the MCP server." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="1430" y="1051" width="490" height="44" as="geometry"/></mxCell><mxCell id="r18c" value="&lt;b&gt;Catalog / discovery&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1.5;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="220" y="1099" width="260" height="44" as="geometry"/></mxCell><mxCell id="r18l" value="Registered in API Center (Foundry has its own model catalog)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1.5;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="490" y="1099" width="400" height="44" as="geometry"/></mxCell><mxCell id="r18m" value="Registered in API Center via publishToApiCenter (Decision #13)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1.5;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="1099" width="400" height="44" as="geometry"/></mxCell><mxCell id="r18v" value="&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1.5;fontSize=11;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="1099" width="110" height="44" as="geometry"/></mxCell><mxCell id="r18p" value="PARITY" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1337" y="1112" width="55" height="18" as="geometry"/></mxCell><mxCell id="r18n" value="Nothing to close." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1.5;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="1430" y="1099" width="490" height="44" as="geometry"/></mxCell><mxCell id="co_unit" value="&lt;b&gt;Why “unit of consumption” is a structural gap&lt;/b&gt;&lt;br&gt;LLM traffic is counted in tokens (llm-token-limit, llm-emit-token-metric); MCP traffic is counted in calls (rate-limit-by-key, quota-by-key, mcp-usage). Do not force a token-equivalent number onto a call — meter calls and correlate against duration. Do not blend tokens and calls into one chargeback figure without normalizing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=14;fontColor=#A4262C;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="1167" width="950" height="120" as="geometry"/></mxCell><mxCell id="co_cs" value="&lt;b&gt;llm-content-safety nuance&lt;/b&gt;&lt;br&gt;The llm-content-safety extension is documented as applicable to MCP tools through a sliding window, but it is NOT adopted in v1 and needs a live test. Until then, response-side content safety and PII stay a gap — enforce them inside the MCP server." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=14;fontColor=#5C4400;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=14;" vertex="1" parent="1"><mxGeometry x="1010" y="1167" width="910" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>