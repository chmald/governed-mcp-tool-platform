" vertex="1" parent="1"><mxGeometry x="1430" y="945" width="490" height="44" as="geometry"/></mxCell><mxCell id="g_safe" value="&lt;b&gt;Safety and discovery&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=bottom;spacingBottom=6;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;spacingTop=8;iconKey=content-safety;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="1003" width="170" height="140" as="geometry"/></mxCell><mxCell id="r16c" value="&lt;b&gt;Response-side content safety&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="220" y="1003" width="260" height="44" as="geometry"/></mxCell><mxCell id="r16l" value="Azure AI Content Safety is a first-party AI-gateway capability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="490" y="1003" width="400" height="44" as="geometry"/></mxCell><mxCell id="r16m" value="Not enforced — Decision #7 (inbound-only) means no outbound inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="1003" width="400" height="44" as="geometry"/></mxCell><mxCell id="r16v" value="&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing