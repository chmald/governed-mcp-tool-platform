        <mxCell id="tl34" value="&lt;b&gt;Suite 4: Governance&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Do the controls actually reject?&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="552" width="470" height="72" as="geometry"/></mxCell>
        <mxCell id="b35" value="4.1 to 4.11, negative by design: bad key 401, quota and rate 429, off-allow-list 403, oversize 413, revoked key 401, usage attribution. 4.9 direct origin blocked is the one most often skipped" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="530" y="552" width="720" height="72" as="geometry"/></mxCell>
