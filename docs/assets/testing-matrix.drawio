        <mxCell id="t3" value="&lt;b&gt;Testing matrix: ten suites, what each proves, when to run it, and its validation status&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="Every row is static-only. The suites are authored and reviewed against Microsoft Learn, not executed against a deployment. Source: docs/04-testing.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="26" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;0 dated live runs recorded.&lt;/b&gt; CHANGELOG.md (2026-08-14) has no live run, so nothing on this page is live-tested. Only the automated tests in Suite 0 run without Azure; rehearse Suites 1 to 10 on your own deployment before relying on them." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1820" height="56" as="geometry"/></mxCell>
