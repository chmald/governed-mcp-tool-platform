        <mxCell id="tl28" value="&lt;b&gt;Suite 3: Session affinity&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Do stateful sessions survive scale-out?&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="468" width="470" height="72" as="geometry"/></mxCell>
