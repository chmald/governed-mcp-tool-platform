        <mxCell id="tl10" value="&lt;b&gt;Suite 0: Automated tests&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Does the code pass its own checks?&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="470" height="72" as="geometry"/></mxCell>
        <mxCell id="b11" value="pytest tests/ plus compileall in CI. Validator SSE parsing, redaction, failure classification, exit codes, sample-server conformance. No infrastructure" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="530" y="216" width="720" height="72" as="geometry"/></mxCell>
