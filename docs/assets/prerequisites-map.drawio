        <mxCell id="acc2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1045" y="0" width="855" height="6" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;Prerequisites map: what must be true before the first deploy&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="Five prerequisite groups feed one pre-flight gate that unlocks Phase 1 (Plane 1) and Phase 3 (Plane 2). Source: docs/02-prerequisites.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="26" as="geometry"/></mxCell>
        <mxCell id="lay5" value="&lt;b&gt;Tenant, tooling and version pins&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=subscription;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="580" height="260" as="geometry"/></mxCell>
        <mxCell id="tl6" value="&lt;b&gt;Tenant-explicit auth&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;az login --tenant, az account set, azd auth login --tenant-id (&amp;#167;2)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="166" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p7" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="234" y="157" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl8" value="&lt;b&gt;Tooling&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;az, azd, kubectl, Docker or Podman, pwsh 7, Python 3.11+, Git, MCP client (&amp;#167;8)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="166" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p9" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="514" y="157" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl10" value="&lt;b&gt;Shared naming&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;&amp;lt;engagement-code&amp;gt;-&amp;lt;env&amp;gt; for AZURE_ENV_NAME and -ResourceLabel (&amp;#167;9)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=resource-group;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p11" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="234" y="261" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl12" value="&lt;b&gt;Pinned upstream commits&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Plane 1 06f7ea6c (citadel-v1), Plane 2 59201a91, no tags (&amp;#167;11)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=commit;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="270" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p13" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="514" y="261" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="lay14" value="&lt;b&gt;Identity and access&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#5C2D91;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="580" height="260" as="geometry"/></mxCell>
        <mxCell id="tl15" value="&lt;b&gt;Azure RBAC&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Plane 1: Owner, or Contributor + User Access Administrator. Plane 2: Owner (&amp;#167;3)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=entra-roles;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="670" y="166" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p16" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="844" y="157" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl17" value="&lt;b&gt;Directory-level role&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Application Administrator, Cloud Application Administrator or Global Administrator (&amp;#167;3)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=enterprise-applications;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="950" y="166" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p18" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1124" y="157" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl19" value="&lt;b&gt;App registration&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Expose api://&amp;lt;clientId&amp;gt; scope access. Pre-authorize VS Code and Azure CLI (&amp;#167;4)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=app-registrations;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="670" y="270" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p20" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="844" y="261" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl21" value="&lt;b&gt;App roles&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;mcp.admin, mcp.engineer. Fail-closed: every caller gets 403 until a role is assigned (&amp;#167;4)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=managed-identity;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="950" y="270" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p22" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1124" y="261" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="lay23" value="&lt;b&gt;Capacity, region and network&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF8F8;strokeColor=#008272;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#008272;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=virtual-network;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="580" height="260" as="geometry"/></mxCell>
        <mxCell id="tl24" value="&lt;b&gt;Resource providers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;17 registered in the &amp;#167;5 loop. Upstream Plane 1 needs about 24, so verify&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1280" y="166" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p25" value="VERIFY" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1468" y="157" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="tl26" value="&lt;b&gt;Quotas&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;APIM units, AKS 8 vCPU (D4ds_v5 x2), public IP, Foundry TPM, Cosmos 400 RU (&amp;#167;6)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=cost-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1560" y="166" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p27" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1734" y="157" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl28" value="&lt;b&gt;Region tiers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Tier 1: East US 2, Sweden Central, West Europe. Availability matrix is likely, not confirmed (&amp;#167;7)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=subscription;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1280" y="270" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p29" value="VERIFY" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1468" y="261" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="tl30" value="&lt;b&gt;VNet address space&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Plane 1 10.170.0.0/24, Plane 2 10.0.0.0/16. Check overlap before accepting (&amp;#167;1)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=virtual-network;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1560" y="270" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p31" value="VERIFY" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1748" y="261" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="lay32" value="&lt;b&gt;APIM MCP requirements (docs/02 &amp;#167;12)&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1190" height="260" as="geometry"/></mxCell>
        <mxCell id="tl33" value="&lt;b&gt;Supported APIM SKU&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Developer, Basic, Basic v2, Standard, Standard v2, Premium, Premium v2. Consumption is NOT supported&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="456" width="370" height="76" as="geometry"/></mxCell>
        <mxCell id="p34" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="344" y="447" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl35" value="&lt;b&gt;MCP protocol 2025-06-18+&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Required for external servers. Confirm the negotiated version with validate_mcp_endpoint.py&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=code;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="450" y="456" width="370" height="76" as="geometry"/></mxCell>
        <mxCell id="p36" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="734" y="447" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl37" value="&lt;b&gt;Frontend Response bytes = 0&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Global-scope diagnostic setting must stay 0 or MCP streaming breaks&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=diagnostic-settings;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="840" y="456" width="370" height="76" as="geometry"/></mxCell>
        <mxCell id="p38" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1124" y="447" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl39" value="&lt;b&gt;App Insights linked to APIM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Needed for native MCP telemetry (api.type = Mcp)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=application-insights;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="370" height="76" as="geometry"/></mxCell>
        <mxCell id="p40" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="344" y="551" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl41" value="&lt;b&gt;Authorization forwarding&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Verify the bearer header reaches the runtime: declare it and forward with set-header&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="450" y="560" width="370" height="76" as="geometry"/></mxCell>
        <mxCell id="p42" value="VERIFY" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="748" y="551" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="tl43" value="&lt;b&gt;Capability limits&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Tools and resources only, no prompts. Not supported in workspace-scoped APIs&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="840" y="560" width="370" height="76" as="geometry"/></mxCell>
