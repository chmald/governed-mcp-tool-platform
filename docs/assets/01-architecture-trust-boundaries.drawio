<mxfile host="Electron" agent="draw.io" version="26.0.0"><diagram id="trust-boundaries" name="Trust boundaries"><mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="8" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="930" y="0" width="770" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Trust boundaries&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1620" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Four boundaries from the public internet to Azure resources; two of them depend on deployment choices, not defaults." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1620" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Secure MCP Gateway Landing Zone  |  trust boundaries  |  v2026-08-14  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1620" height="20" as="geometry"/></mxCell><mxCell id="c0" value="Untrusted: public" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#A4262C;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#A4262C;spacingTop=8;fontFamily=Segoe UI;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=users;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="520" as="geometry"/></mxCell><mxCell id="c1" value="Boundary 1: governance edge" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;fontFamily=Segoe UI;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="300" height="520" as="geometry"/></mxCell><mxCell id="c2" value="Boundary 2: runtime edge" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;fontFamily=Segoe UI;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=application-gateway;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="320" height="520" as="geometry"/></mxCell><mxCell id="c3" value="Boundary 3: workload isolation" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3F9F1;strokeColor=#107C10;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#107C10;spacingTop=8;fontFamily=Segoe UI;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="280" height="520" as="geometry"/></mxCell><mxCell id="c4" value="Azure resources" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;spacingTop=8;fontFamily=Segoe UI;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=entra-workload-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1480" y="110" width="180" height="520" as="geometry"/></mxCell><mxCell id="t_client" value="&lt;b style=&quot;font-size:13px&quot;&gt;MCP clients&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;IDE or agent workload&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=8;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="180" height="110" as="geometry"/></mxCell><mxCell id="t_apim" value="&lt;b style=&quot;font-size:13px&quot;&gt;API Management&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;authN, entitlement, quota, metering&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=8;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="260" height="110" as="geometry"/></mxCell><mxCell id="t_agw" value="&lt;b style=&quot;font-size:13px&quot;&gt;Application Gateway&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;TLS termination&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=8;iconKey=application-gateway;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="740" y="200" width="280" height="110" as="geometry"/></mxCell><mxCell id="t_mgw" value="&lt;b style=&quot;font-size:13px&quot;&gt;MCP Gateway&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;token validation, resource RBAC, session scoping&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=8;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="740" y="350" width="280" height="110" as="geometry"/></mxCell><mxCell id="t_pods" value="&lt;b style=&quot;font-size:13px&quot;&gt;MCP server pods&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;NetworkPolicy default-deny, non-root, no privilege escalation&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=8;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1140" y="200" width="240" height="130" as="geometry"/></mxCell><mxCell id="t_azure" value="&lt;b style=&quot;font-size:13px&quot;&gt;Workload identity&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;federation, admin-only role&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;spacingLeft=50;spacingRight=8;iconKey=entra-workload-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1500" y="200" width="140" height="130" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=classic;html=1;strokeColor=#A4262C;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t_client" target="t_apim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" style="endArrow=classic;html=1;strokeColor=#0078D4;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t_apim" target="t_agw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" style="endArrow=classic;html=1;strokeColor=#0078D4;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t_agw" target="t_mgw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" style="endArrow=classic;html=1;strokeColor=#107C10;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="t_mgw" target="t_pods"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" style="endArrow=classic;html=1;strokeColor=#5C2D91;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t_pods" target="t_azure"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="289" y="233" width="22" height="22" as="geometry"/></mxCell><mxCell id="n2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="669" y="233" width="22" height="22" as="geometry"/></mxCell><mxCell id="n3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="869" y="316" width="22" height="22" as="geometry"/></mxCell><mxCell id="n4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1069" y="382" width="22" height="22" as="geometry"/></mxCell><mxCell id="n5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1429" y="253" width="22" height="22" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;Fails closed:&lt;/b&gt; yes&lt;br/&gt;no key, no call" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="360" y="500" width="260" height="56" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;Fails closed:&lt;/b&gt; depends on network configuration (see the two weaknesses below)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#323130;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="740" y="500" width="280" height="56" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;Fails closed:&lt;/b&gt; yes&lt;br/&gt;admin-only defaults for privileged capabilities" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1140" y="500" width="240" height="56" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;Fails closed:&lt;/b&gt; yes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1500" y="500" width="140" height="56" as="geometry"/></mxCell><mxCell id="f0" value="&lt;b&gt;No inherent trust&lt;/b&gt;&lt;br/&gt;every call must present credentials" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#A4262C;strokeWidth=1.5;fontColor=#323130;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="130" height="70" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Weakness 2: direct origin access&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;nothing inherently stops a client reaching the runtime origin, bypassing quota and metering&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=8;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="680" width="340" height="120" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Weakness 1: HTTP-only edge listener&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;the runtime edge is cleartext until you add a TLS listener (Phase 4)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=8;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="720" y="680" width="320" height="120" as="geometry"/></mxCell><mxCell id="bypass" style="endArrow=classic;html=1;strokeColor=#A4262C;strokeWidth=2;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.9;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="t_client" target="w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nb" value="!" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="211" y="650" width="22" height="22" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Numbered paths&lt;/b&gt;&lt;br/&gt;1  subscription key + bearer token&lt;br/&gt;2  private network + TLS&lt;br/&gt;3  inside the runtime edge&lt;br/&gt;4  cluster-internal only, with forwarded identity headers&lt;br/&gt;5  workload identity federation&lt;br/&gt;&lt;span style=&quot;color:#A4262C&quot;&gt;&lt;b&gt;Red dashed&lt;/b&gt;: bypass path to close during deployment&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;dashed=1;fontColor=#323130;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1100" y="680" width="540" height="130" as="geometry"/></mxCell><mxCell id="hint" value="Close both weaknesses during deployment, not after: treat &lt;b&gt;the governed path is the only path&lt;/b&gt; as a requirement, not an assumption." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#323130;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1620" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>