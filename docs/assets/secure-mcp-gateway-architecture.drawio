<mxfile host="Electron" agent="draw.io" version="26.0.0"><diagram id="smgw-arch" name="Two-Plane Reference Architecture"><mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2070" pageHeight="1410" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1110" height="6" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1130" y="10" width="920" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Secure MCP Gateway Landing Zone — Two-Plane Reference Architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1990" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Governance edge (Citadel Governance Hub) + MCP runtime (microsoft/mcp-gateway) joined by a Publish Contract — assetType: mcp-existing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1990" height="26" as="geometry"/></mxCell><mxCell id="lg_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1345" width="60" height="20" as="geometry"/></mxCell><mxCell id="lgp0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="110" y="1346" width="62" height="18" as="geometry"/></mxCell><mxCell id="lgt0" value="Out-of-the-box default" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="178" y="1345" width="141" height="20" as="geometry"/></mxCell><mxCell id="lgp1" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="333" y="1346" width="62" height="18" as="geometry"/></mxCell><mxCell id="lgt1" value="Versioned, preview subsystem" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="401" y="1345" width="176" height="20" as="geometry"/></mxCell><mxCell id="lgp2" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="591" y="1346" width="68" height="18" as="geometry"/></mxCell><mxCell id="lgt2" value="Opt-in / not required" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="665" y="1345" width="135" height="20" as="geometry"/></mxCell><mxCell id="lgp3" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="814" y="1346" width="68" height="18" as="geometry"/></mxCell><mxCell id="lgt3" value="Mandatory hardening step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="888" y="1345" width="153" height="20" as="geometry"/></mxCell><mxCell id="footer" value="Secure MCP Gateway Landing Zone | Two-plane reference architecture | v2026-08-14 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1377" width="1990" height="20" as="geometry"/></mxCell><mxCell id="howto" value="&lt;b&gt;How to read:&lt;/b&gt; left to right is the request path. Blue = Plane 1 (governance edge), green = Plane 2 (MCP runtime), purple = shared services. Solid arrows = request path, dashed = registration / entitlement / image pull." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#C8C6C4;strokeWidth=1.5;fontSize=10;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="1330" width="930" height="40" as="geometry"/></mxCell><mxCell id="g_cons" value="Consumers" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#A4262C;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=users;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="220" height="945" as="geometry"/></mxCell><mxCell id="c_ide" value="&lt;b&gt;Interactive MCP client&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;IDE / agent host&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="55" y="225" width="190" height="80" as="geometry"/></mxCell><mxCell id="c_app" value="&lt;b&gt;Application / agent workload&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=app-service;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="55" y="325" width="190" height="80" as="geometry"/></mxCell><mxCell id="c_creds" value="&lt;b&gt;Every governed call carries TWO credentials&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;api-key header&lt;/b&gt;&lt;br&gt;→ which business unit? what quota?&lt;br&gt;&lt;br&gt;&lt;b&gt;Authorization: Bearer&lt;/b&gt;&lt;br&gt;→ which principal? what may they reach?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=top;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="470" width="190" height="190" as="geometry"/></mxCell><mxCell id="c_bu" value="&lt;b&gt;Consuming business unit&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=enterprise-applications;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="55" y="847" width="190" height="70" as="geometry"/></mxCell><mxCell id="g_p1" value="Plane 1 — Governance edge (Citadel Governance Hub)" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5FAFF;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#0078D4;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="165" width="520" height="945" as="geometry"/></mxCell><mxCell id="apim" value="&lt;b&gt;Azure API Management — native MCP API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;type: mcp · transportType: streamable&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;StandardV2 by default · one front door shared with LLM traffic&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="350" y="215" width="400" height="200" as="geometry"/></mxCell><mxCell id="apim_p0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="680" y="206" width="62" height="18" as="geometry"/></mxCell><mxCell id="frag" value="&lt;b&gt;Policy fragments (INBOUND ONLY)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;security-handler → subscription key (+ optional JWT)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;mcp-usage → inbound request-count metric&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Authorization header is NOT rewritten&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="350" y="440" width="400" height="106" as="geometry"/></mxCell><mxCell id="seam" value="&lt;b&gt;INTEGRATION SEAM — Publish Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;assetType: mcp-existing&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Creates: dedicated backend + circuit breaker (3 failures / PT5M → trip PT1M)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Endpoint: {gateway}/mcp/&amp;lt;path&amp;gt; (no trailing /mcp)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="350" y="570" width="400" height="136" as="geometry"/></mxCell><mxCell id="seam_p0" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="680" y="561" width="62" height="18" as="geometry"/></mxCell><mxCell id="apic" value="&lt;b&gt;Azure API Center&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;discovery catalog&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=api-center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="350" y="740" width="400" height="70" as="geometry"/></mxCell><mxCell id="apic_p0" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="674" y="731" width="68" height="18" as="geometry"/></mxCell><mxCell id="prod" value="&lt;b&gt;Access Contract Product + Subscription&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;rate limit · quota · revocation point&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;MULTI- product grants LLM + tools under ONE key and ONE quota&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="350" y="835" width="400" height="115" as="geometry"/></mxCell><mxCell id="prod_p0" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="680" y="826" width="62" height="18" as="geometry"/></mxCell><mxCell id="sse_warn" value="&lt;b&gt;⚠ MCP STREAMS OVER SSE:&lt;/b&gt; reading context.Response.Body buffers the stream and BREAKS the protocol. ALL policy is INBOUND ONLY. Response-side PII de-anonymization and response content safety are ARCHITECTURALLY IMPOSSIBLE. Enforce those in the MCP server itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=10.5;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="970" width="400" height="105" as="geometry"/></mxCell><mxCell id="g_p2" value="Plane 2 — MCP runtime (microsoft/mcp-gateway on AKS)" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6FBF6;strokeColor=#107C10;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#107C10;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1010" y="165" width="540" height="945" as="geometry"/></mxCell><mxCell id="agw" value="&lt;b&gt;Application Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;TLS termination&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=application-gateway;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1030" y="215" width="240" height="100" as="geometry"/></mxCell><mxCell id="agw_p0" value="REQUIRED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1194" y="206" width="68" height="18" as="geometry"/></mxCell><mxCell id="agw_warn" value="&lt;b&gt;⚠ Upstream ships an HTTP-only listener.&lt;/b&gt; Add TLS + an origin lock BEFORE pointing API Management at it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="1280" y="215" width="250" height="100" as="geometry"/></mxCell><mxCell id="aks" value="Azure Kubernetes Service" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;dashed=1;verticalAlign=bottom;align=left;fontStyle=1;fontSize=13;fontColor=#107C10;spacingBottom=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=bottom;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1030" y="345" width="500" height="750" as="geometry"/></mxCell><mxCell id="mgw" value="&lt;b&gt;MCP Gateway service&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Control plane: /adapters /tools&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Data plane: POST /adapters/{name}/mcp | POST /mcp&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Validates the caller&amp;#x27;s Entra token INDEPENDENTLY&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Applies resource RBAC: mcp.admin / mcp.engineer&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=ai-gateway;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1050" y="370" width="460" height="150" as="geometry"/></mxCell><mxCell id="sess" value="&lt;b&gt;Session routing + session store&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;New session → random healthy pod; existing session → pinned pod&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Scoped key = (principal, adapter, session id) → a session id cannot be replayed by another caller&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=cosmos-db;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1050" y="540" width="460" height="110" as="geometry"/></mxCell><mxCell id="tgw" value="&lt;b&gt;Tool Gateway Router&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;StatefulSet — own session affinity&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1050" y="670" width="460" height="60" as="geometry"/></mxCell><mxCell id="g_np" value="Kubernetes NetworkPolicy — namespace: adapter — DEFAULT DENY (only gateway / tool-gateway pods may reach these)" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;dashed=1;verticalAlign=bottom;align=left;fontStyle=1;fontSize=11;fontColor=#A4262C;spacingBottom=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=bottom;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=nsg;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1050" y="765" width="460" height="285" as="geometry"/></mxCell><mxCell id="ad1" value="&lt;b&gt;MCP server adapter A&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;StatefulSet + headless Service&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;replicas: 0 · 1 · N&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=10.5;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=code;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1058" y="795" width="215" height="110" as="geometry"/></mxCell><mxCell id="ad2" value="&lt;b&gt;MCP server adapter B&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;StatefulSet + headless Service&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;replicas: 0 · 1 · N&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=10.5;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=code;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1288" y="795" width="215" height="110" as="geometry"/></mxCell><mxCell id="fwd" value="&lt;b&gt;Forwarded identity to pods:&lt;/b&gt; X-Mcp-UserId / X-Mcp-Roles. Client-supplied X-Mcp-* headers are STRIPPED first (cannot be forged). The raw Authorization header is NOT forwarded to the pod." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=10.5;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="920" width="440" height="75" as="geometry"/></mxCell><mxCell id="g_shared" value="Shared platform services" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FBF8FF;strokeColor=#5C2D91;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#5C2D91;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=resource-group;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1650" y="165" width="380" height="945" as="geometry"/></mxCell><mxCell id="foundry" value="&lt;b&gt;Microsoft Foundry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;model backends&lt;/font&gt;" style="shape=label;rounded=1;ar