mxGeometry x="1670" y="920" width="340" height="150" as="geometry"/></mxCell><mxCell id="evh" value="&lt;b&gt;Event Hubs&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=bottom;spacingBottom=6;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;spacingTop=8;iconKey=event-hubs;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1685" y="965" width="92" height="90" as="geometry"/></mxCell><mxCell id="logic" value="&lt;b&gt;Logic App&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=bottom;spacingBottom=6;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;spacingTop=8;iconKey=logic-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1797" y="965" width="92" height="90" as="geometry"/></mxCell><mxCell id="cosmos" value="&lt;b&gt;Cosmos DB&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=bottom;spacingBottom=6;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;spacingTop=8;iconKey=cosmos-db;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1909" y="965" width="92" height="90" as="geometry"/></mxCell><mxCell id="comp" value="Compensating controls — the edge supplies what the runtime lacks" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFBF0;strokeColor=#B7791F;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#B7791F;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;ic