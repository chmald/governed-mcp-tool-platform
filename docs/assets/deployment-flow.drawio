<mxfile host="Electron" version="26.0.0">
  <diagram id="page1" name="1 Phases 0-8">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="acc1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1045" height="6" as="geometry"/></mxCell>
        <mxCell id="acc2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1045" y="0" width="855" height="6" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;Deployment flow: nine phases from tenant-explicit login to end-to-end proof&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="Phase 4 (TLS and origin lock) is mandatory and gates everything after it. Durations are estimates, not measurements. Source: docs/03-deployment.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="26" as="geometry"/></mxCell>
        <mxCell id="tl5" value="&lt;b&gt;Phase 0: Tenant-explicit auth&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;az login --tenant, az account set&lt;br&gt;azd auth login --tenant-id&lt;br&gt;Never trust the ambient account&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p6" value="~5 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="288" y="131" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="tl7" value="&lt;b&gt;Phase 1: Governance plane&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;azd up: Citadel Governance Hub (Plane 1)&lt;br&gt;Exit gate: /version responds&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="410" y="140" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p8" value="30-45 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="637" y="131" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="tl9" value="&lt;b&gt;Phase 2: Entra app and roles&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;App registration, api://&amp;lt;clientId&amp;gt; scope&lt;br&gt;App roles mcp.admin and mcp.engineer&lt;br&gt;Fail-closed until a role is assigned&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=app-registrations;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="780" y="140" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p10" value="20-30 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1007" y="131" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="tl11" value="&lt;b&gt;Phase 3: MCP runtime on AKS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Deploy-McpGateway.ps1 -EnablePrivateEndpoints&lt;br&gt;Cosmos containers, NetworkPolicy&lt;br&gt;Strong GatewaySettings__Secret&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1150" y="140" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p12" value="15-25 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1377" y="131" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="tl13" value="&lt;b&gt;Phase 4: TLS and origin lock&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Upstream serves HTTP:80 only&lt;br&gt;Certificate, HTTPS listener, redirect, origin lock&lt;br&gt;Detail on page 2&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=3;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1520" y="140" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p14" value="20-40 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1747" y="131" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="p15" value="MANDATORY" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1660" y="131" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="tl16" value="&lt;b&gt;Phase 5: Build and register adapter&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;az acr build, UID 1100&lt;br&gt;Register-McpAdapter.ps1, 2+ replicas&lt;br&gt;-RequiredRoles mcp.engineer&lt;br&gt;StatefulSet + headless Service&lt;br&gt;validate_mcp_endpoint.py&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p17" value="15-25 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="267" y="371" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="tl18" value="&lt;b&gt;Phase 6: Publish through APIM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;mcp-existing, streamable&lt;br&gt;Publish-McpAsset.ps1 (what-if first)&lt;br&gt;https://&amp;lt;APIM_HOST&amp;gt;/mcp/&amp;lt;ASSET_PATH&amp;gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="410" y="380" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p19" value="10-15 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="637" y="371" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="tl20" value="&lt;b&gt;Phase 7: Access Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;mcp-consumer.bicepparam&lt;br&gt;az deployment sub create&lt;br&gt;Key MCP-TOOL-API-KEY in Key Vault&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="780" y="380" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p21" value="10-15 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1007" y="371" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="tl22" value="&lt;b&gt;Phase 8: End-to-end validation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;9-test control proof&lt;br&gt;Telemetry check, real MCP client&lt;br&gt;No-secret check&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1150" y="380" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p23" value="~15 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1391" y="371" width="67" height="18" as="geometry"/></mxCell>
        <mxCell id="tl24" value="&lt;b&gt;Teardown (optional)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;azd down --purge&lt;br&gt;Delete the MCP resource group&lt;br&gt;az ad app delete&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=resource-group;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1520" y="380" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p25" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1754" y="371" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl5" target="tl7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl7" target="tl9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl9" target="tl11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl11" target="tl13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl16" target="tl18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl18" target="tl20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl20" target="tl22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#605E5C;strokeWidth=2;endArrow=classic;endFill=1;dashed=1;" edge="1" parent="1" source="tl22" target="tl24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A4262C;strokeWidth=2;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tl13" target="tl16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="340"/><mxPoint x="200" y="340"/></Array></mxGeometry></mxCell>
        <mxCell id="e34l" value="Gate passed: valid TLS, redirect, origin lock verified" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#A4262C;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;" vertex="1" connectable="0" parent="e34"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="b35" value="&lt;b&gt;Why Phase 4 is mandatory&lt;/b&gt;&lt;br&gt;The upstream deployment exposes the MCP runtime on an Application Gateway HTTP:80 listener. Pointing API Management at that origin sends every tool call, including the bearer token in the Authorization header, in cleartext. TLS alone does not stop a client from calling the runtime directly, so the origin lock is part of the phase." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=2;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1180" height="120" as="geometry"/></mxCell>
        <mxCell id="b36" value="&lt;b&gt;First-time total: about half a day&lt;/b&gt;&lt;br&gt;Phase durations are estimates from docs/03 (Phase 3 is flagged as an estimate there). No timing here comes from a measured run." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1240" y="590" width="620" height="120" as="geometry"/></mxCell>
        <mxCell id="lay37" value="&lt;b&gt;Exit gates that decide whether the next phase may start&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#107C10;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1820" height="150" as="geometry"/></mxCell>
        <mxCell id="tl38" value="&lt;b&gt;Phase 1 gate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;/version responds from the governance plane&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="796" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="tl39" value="&lt;b&gt;Phase 4 gate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Valid TLS chain, redirect, hostname match, origin lock verified, httpsListenerConfigured true&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=2.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="500" y="796" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="tl40" value="&lt;b&gt;Phase 6 gate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Publish-McpAsset.ps1 what-if reviewed before apply&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="796" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="tl41" value="&lt;b&gt;Phase 8 gate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;9-test control proof passes and no secret appears in output&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1380" y="796" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="t42" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="p43" value="~15 min" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="104" y="921" width="67" height="18" as="geometry"/></mxCell>
        <mxCell id="t44" value="estimated duration" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="177" y="920" width="112" height="20" as="geometry"/></mxCell>
        <mxCell id="p45" value="MANDATORY" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="307" y="921" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="t46" value="never skip" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="394" y="920" width="68" height="20" as="geometry"/></mxCell>
        <mxCell id="p47" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="480" y="921" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="t48" value="teardown only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="560" y="920" width="84" height="20" as="geometry"/></mxCell>
        <mxCell id="t49" value="Border colour: purple identity, blue governance plane, teal MCP runtime plane, green proof, red mandatory gate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="944" width="1800" height="20" as="geometry"/></mxCell>
        <mxCell id="t50" value="Secure MCP Gateway Landing Zone | Deployment flow | v2026-08-14 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="972" width="1820" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page2" name="2 Phase 4 detail">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="960" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="acc1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1045" height="6" as="geometry"/></mxCell>
        <mxCell id="acc2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1045" y="0" width="855" height="6" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;Phase 4 detail: four steps, one gate, no exceptions&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="Certificate, HTTPS listener, origin lock and verification. Phase 5 does not start until every gate item is ticked. Source: docs/03-deployment.md Phase 4." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="26" as="geometry"/></mxCell>
        <mxCell id="tl5" value="&lt;b&gt;4.1 Obtain a certificate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Key Vault certificate with an integrated issuer, an enterprise CA cert imported into Key Vault, or an App Service Certificate. Application Gateway identity gets get on secrets and certificates&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="n6" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="32" y="131" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="tl7" value="&lt;b&gt;4.2 Add an HTTPS listener&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Application Gateway: HTTPS listener on 443 with the Key Vault certificate, a routing rule to the existing backend pool, and an HTTP-to-HTTPS redirect on port 80&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=application-gateway;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="n8" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="492" y="131" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="tl9" value="&lt;b&gt;4.3 Lock the origin&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;TLS protects traffic but does not stop a direct call that bypasses API Management and its quota, metering and chargeback. Pick the strongest option below&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=nsg;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="960" y="140" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="n10" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="952" y="131" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="tl11" value="&lt;b&gt;4.4 Verify TLS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;curl -sSI https://&amp;lt;origin&amp;gt;/healthz must answer&lt;br&gt;curl -sSI http://&amp;lt;origin&amp;gt;/healthz must redirect&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1420" y="140" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="n12" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1412" y="131" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl5" target="tl7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl7" target="tl9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl9" target="tl11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lay16" value="&lt;b&gt;Step 4.3 origin lock options, ranked&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FDF3F4;strokeColor=#A4262C;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#A4262C;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=firewall;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1820" height="190" as="geometry"/></mxCell>
        <mxCell id="tl17" value="&lt;b&gt;Private connectivity&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Reach the runtime origin over private networking only. No public ingress path&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=private-link;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="416" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="p18" value="STRONGEST" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="527" y="407" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="tl19" value="&lt;b&gt;IP restriction&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Restrict Application Gateway to the API Management outbound addresses&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=firewall;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="660" y="416" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="p20" value="STRONG" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1148" y="407" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="tl21" value="&lt;b&gt;Shared origin secret&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Header injected by API Management and validated at the runtime edge. Defense in depth only&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1260" y="416" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="p22" value="WEAKEST" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1741" y="407" width="67" height="18" as="geometry"/></mxCell>
        <mxCell id="lay23" value="&lt;b&gt;Validation gate: all six must be true&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#107C10;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1180" height="280" as="geometry"/></mxCell>
        <mxCell id="tl24" value="&lt;b&gt;Valid, trusted certificate chain&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="626" width="550" height="60" as="geometry"/></mxCell>
        <mxCell id="tl25" value="&lt;b&gt;HTTP requests redirect to HTTPS&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="630" y="626" width="550" height="60" as="geometry"/></mxCell>
        <mxCell id="tl26" value="&lt;b&gt;Certificate hostname matches the APIM target&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="698" width="550" height="60" as="geometry"/></mxCell>
        <mxCell id="tl27" value="&lt;b&gt;Expiry recorded and a renewal path exists&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="630" y="698" width="550" height="60" as="geometry"/></mxCell>
        <mxCell id="tl28" value="&lt;b&gt;Origin lock verified by an attempted direct call&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="550" height="60" as="geometry"/></mxCell>
        <mxCell id="tl29" value="&lt;b&gt;demo-ids.local.json: httpsListenerConfigured true&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="630" y="770" width="550" height="60" as="geometry"/></mxCell>
        <mxCell id="tl30" value="&lt;b&gt;Continue to Phase 5&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Build and register the adapter. Origin lock is re-proved by the direct call in Phase 8&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1260" y="626" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="tl31" value="&lt;b&gt;Stop here&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Do not publish through APIM and do not register consumers until every item passes&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=2.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1260" y="750" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="p32" value="ALL TRUE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1774" y="617" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="p33" value="ANY FALSE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1767" y="741" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#107C10;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lay23" target="tl30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A4262C;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lay23" target="tl31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t36" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="p37" value="ALL TRUE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="104" y="881" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="t38" value="every gate item ticked" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="184" y="880" width="135" height="20" as="geometry"/></mxCell>
        <mxCell id="p39" value="ANY FALSE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="337" y="881" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="t40" value="stop" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="424" y="880" width="34" height="20" as="geometry"/></mxCell>
        <mxCell id="p41" value="STRONGEST" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="476" y="881" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="t42" value="best origin lock" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="563" y="880" width="101" height="20" as="geometry"/></mxCell>
        <mxCell id="p43" value="STRONG" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="682" y="881" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="t44" value="acceptable" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="748" y="880" width="68" height="20" as="geometry"/></mxCell>
        <mxCell id="p45" value="WEAKEST" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="834" y="881" width="67" height="18" as="geometry"/></mxCell>
        <mxCell id="t46" value="defense in depth only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="907" y="880" width="129" height="20" as="geometry"/></mxCell>
        <mxCell id="t47" value="Note: the Azure DevOps pipeline only checks that an HTTPS listener exists. Certificate validity, redirect and origin lock remain manual." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="904" width="1800" height="20" as="geometry"/></mxCell>
        <mxCell id="t48" value="Secure MCP Gateway Landing Zone | Deployment flow | v2026-08-14 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1820" height="20" as="geometry"/></mxCell>
