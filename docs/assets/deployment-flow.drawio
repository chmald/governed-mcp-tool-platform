  <diagram id="page3" name="3 Azure DevOps pipeline">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="960" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="acc1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1045" height="6" as="geometry"/></mxCell>
        <mxCell id="acc2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1045" y="0" width="855" height="6" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;Azure DevOps pipeline: six stages, two approval gates, one TLS check&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="Pipeline file .azuredevops/pipelines/deploy-secure-mcp-gateway.yml. It automates Phases 1, 3, 5 build, 6 and a smoke test, not the whole runbook." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="26" as="geometry"/></mxCell>
        <mxCell id="tl5" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;compileall, pytest&lt;br&gt;az bicep build&lt;br&gt;PSScriptAnalyzer (soft)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="tl6" value="&lt;b&gt;BuildImage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;az acr build&lt;br&gt;Adapter image into ACR&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="346" y="140" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="tl7" value="&lt;b&gt;DeployGovernancePlane&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Environment secure-mcp-gateway-governance-plane&lt;br&gt;azd up --no-prompt&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="652" y="140" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="p8" value="APPROVAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="836" y="131" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl9" value="&lt;b&gt;DeployMcpPlane&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Environment secure-mcp-gateway-mcp-plane&lt;br&gt;Clone pinned mcp-gateway&lt;br&gt;az deployment group create (upstream Bicep)&lt;br&gt;kubectl apply via envsubst&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="958" y="140" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="p10" value="APPROVAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1142" y="131" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="tl11" value="&lt;b&gt;PublishAsset&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Publish-McpAsset.ps1&lt;br&gt;Publishes the asset through APIM&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1264" y="140" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="tl12" value="&lt;b&gt;SmokeTest&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;validate_mcp_endpoint.py --json&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1570" y="140" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl5" target="tl6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl6" target="tl7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl7" target="tl9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl11" target="tl12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="tl17" value="&lt;b&gt;Gate: runtime edge terminates TLS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Last step of DeployMcpPlane. Fails the stage if there is no HTTPS listener&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=3;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="958" y="390" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="p18" value="FAIL CLOSED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1121" y="381" width="95" height="18" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A4262C;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl9" target="tl17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#107C10;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="tl17" target="tl11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e20l" value="listener found" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;" vertex="1" connectable="0" parent="e20"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="b21" value="&lt;b&gt;What the gate does not check&lt;/b&gt;&lt;br&gt;It only confirms an HTTPS listener exists. Certificate validity, the HTTP redirect and the origin lock are not tested, so Phase 4 stays a manual, verified step." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1440" y="390" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="lay22" value="&lt;b&gt;Triggers, identity and secrets&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=azure-devops;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="880" height="190" as="geometry"/></mxCell>
        <mxCell id="tl23" value="&lt;b&gt;Triggers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Push to main and pull requests to main&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=commit;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="446" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="tl24" value="&lt;b&gt;Tenant scoping&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Service connection sets the tenant. No interactive az login&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=entra-workload-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="446" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="tl25" value="&lt;b&gt;Secrets&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Variable group or Key Vault, never the repo&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="620" y="446" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="lay26" value="&lt;b&gt;Not run by the pipeline: do these by hand&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#CA5010;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#CA5010;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=powershell;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1820" height="200" as="geometry"/></mxCell>
        <mxCell id="tl27" value="&lt;b&gt;Phase 2 Entra&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;App registration and app roles&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=app-registrations;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="334" height="110" as="geometry"/></mxCell>
        <mxCell id="p28" value="MANUAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="322" y="667" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="tl29" value="&lt;b&gt;Phase 4 TLS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Certificate, listener and origin lock. Pipeline only verifies a listener&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="414" y="676" width="334" height="110" as="geometry"/></mxCell>
        <mxCell id="p30" value="MANUAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="676" y="667" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="tl31" value="&lt;b&gt;Phase 5 register&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Register-McpAdapter.ps1 with 2+ replicas&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="768" y="676" width="334" height="110" as="geometry"/></mxCell>
        <mxCell id="p32" value="MANUAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1030" y="667" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="tl33" value="&lt;b&gt;Phase 7 Access Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;mcp-consumer.bicepparam deployment&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1122" y="676" width="334" height="110" as="geometry"/></mxCell>
        <mxCell id="p34" value="MANUAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1384" y="667" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="tl35" value="&lt;b&gt;Phase 8 full proof&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;9-test control proof. Pipeline only smoke-tests&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1476" y="676" width="334" height="110" as="geometry"/></mxCell>
        <mxCell id="p36" value="MANUAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1738" y="667" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="t37" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="p38" value="APPROVAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="104" y="851" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="t39" value="manual approval on the environment" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="184" y="850" width="202" height="20" as="geometry"/></mxCell>
        <mxCell id="p40" value="FAIL CLOSED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="404" y="851" width="95" height="18" as="geometry"/></mxCell>
        <mxCell id="t41" value="stage fails without HTTPS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="505" y="850" width="152" height="20" as="geometry"/></mxCell>
        <mxCell id="p42" value="MANUAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="675" y="851" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="t43" value="outside the pipeline" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="741" y="850" width="124" height="20" as="geometry"/></mxCell>
        <mxCell id="t44" value="Border colour: blue governance plane, teal MCP runtime plane, green proof, red gate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="874" width="1800" height="20" as="geometry"/></mxCell>
