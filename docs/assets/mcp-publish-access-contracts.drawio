<mxfile host="Electron" agent="draw.io" version="26.0.0"><diagram id="smgw-contracts" name="Publish vs Access Contract"><mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1050" height="6" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1070" y="10" width="870" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Secure MCP Gateway Landing Zone — Publish Contract vs Access Contract&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1880" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Publishing says what is exposed; the Access Contract says who may call it. Publishing entitles nobody." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1880" height="26" as="geometry"/></mxCell><mxCell id="lg_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1262" width="60" height="20" as="geometry"/></mxCell><mxCell id="lgp0" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="110" y="1263" width="62" height="18" as="geometry"/></mxCell><mxCell id="lgt0" value="Versioned, preview subsystem" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="178" y="1262" width="176" height="20" as="geometry"/></mxCell><mxCell id="lgp1" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="368" y="1263" width="68" height="18" as="geometry"/></mxCell><mxCell id="lgt1" value="Opt-in / not required" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="442" y="1262" width="135" height="20" as="geometry"/></mxCell><mxCell id="footer" value="Secure MCP Gateway Landing Zone | Publish vs Access Contract (mcp-existing) | v2026-08-14 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1294" width="1880" height="20" as="geometry"/></mxCell><mxCell id="st_pill" value="STATIC-ONLY" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#8A8886;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1600" y="34" width="87" height="18" as="geometry"/></mxCell><mxCell id="st_txt" value="Authored and reviewed, never run live" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1704" y="31" width="250" height="24" as="geometry"/></mxCell><mxCell id="howto" value="&lt;b&gt;How to read:&lt;/b&gt; left to right — blue = Publish Contract, green = the governed asset, purple = Access Contract. Solid arrows = what each contract does to the asset." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#C8C6C4;strokeWidth=1.5;fontSize=10;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="1250" width="1140" height="44" as="geometry"/></mxCell><mxCell id="g_pub" value="① Publish Contract — assetType: mcp-existing" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5FAFF;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="620" height="520" as="geometry"/></mxCell><mxCell id="pub_pv" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="590" y="101" width="62" height="18" as="geometry"/></mxCell><mxCell id="pub_q" value="&lt;b&gt;Answers:&lt;/b&gt; what is exposed, and where does it point?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEECF9;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#0078D4;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="166" width="590" height="36" as="geometry"/></mxCell><mxCell id="pub_be" value="&lt;b&gt;1 · API Management backend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;dedicated per asset (never shared) · URL must be https://&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;circuit breaker: failureCount 3 · failureInterval PT5M&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;tripDuration PT1M · acceptRetryAfter true&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="55" y="216" width="590" height="106" as="geometry"/></mxCell><mxCell id="pub_api" value="&lt;b&gt;2 · API of native type mcp&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;transportType: streamable — API Management understands MCP&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="55" y="334" width="590" height="70" as="geometry"/></mxCell><mxCell id="pub_pol" value="&lt;b&gt;3 · Baseline MCP policy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;security-handler (subscription key + optional JWT) · mcp-usage&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;inbound only — deliberately nothing outbound&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="55" y="416" width="590" height="84" as="geometry"/></mxCell><mxCell id="pub_apic" value="&lt;b&gt;4 · API Center registration&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;ownership · lifecycle · classification metadata&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=api-center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="55" y="512" width="590" height="70" as="geometry"/></mxCell><mxCell id="pub_apic_p0" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="569" y="503" width="68" height="18" as="geometry"/></mxCell><mxCell id="pub_run" value="&lt;b&gt;Run when: a new MCP server should exist on the gateway  ·  Frequency: once per asset&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#0078D4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="55" y="588" width="590" height="32" as="geometry"/></mxCell><mxCell id="g_asset" value="Governed MCP asset" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6FFF6;strokeColor=#107C10;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#107C10;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="730" y="110" width="500" height="520" as="geometry"/></mxCell><mxCell id="a_ep" value="&lt;b&gt;Published endpoint&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;{gateway}/mcp/&amp;lt;path&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;no trailing /mcp for mcp-existing&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="745" y="170" width="470" height="100" as="geometry"/></mxCell><mxCell id="a_rt" value="&lt;b&gt;MCP runtime&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;microsoft/mcp-gateway on AKS&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;behind the asset&amp;#x27;s own backend&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="745" y="310" width="470" height="84" as="geometry"/></mxCell><mxCell id="a_401" value="&lt;b&gt;Before an Access Contract: 401 — not 404&lt;/b&gt;&lt;br&gt;Publishing entitles nobody. This is the correct, intended state and proves routing works." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#A4262C;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=10;" vertex="1" parent="1"><mxGeometry x="745" y="430" width="470" height="90" as="geometry"/></mxCell><mxCell id="a_ok" value="&lt;b&gt;After an Access Contract&lt;/b&gt;&lt;br&gt;The consumer&#x27;s key and token are entitled; the call is routed to the runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#0B5A0B;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=10;" vertex="1" parent="1"><mxGeometry x="745" y="530" width="470" height="80" as="geometry"/></mxCell><mxCell id="g_acc" value="② Access Contract" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAF7FF;strokeColor=#5C2D91;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=enterprise-applications;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1300" y="110" width="620" height="520" as="geometry"/></mxCell><mxCell id="acc_pv" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1850" y="101" width="62" height="18" as="geometry"/></mxCell><mxCell id="acc_q" value="&lt;b&gt;Answers:&lt;/b&gt; who may call it, and how much?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE6F8;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#5C2D91;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="1315" y="166" width="590" height="36" as="geometry"/></mxCell><mxCell id="acc_prod" value="&lt;b&gt;1 · Product per service code&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;TOOL → the published MCP API · LLM → the LLM APIs&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;MULTI- prefix: one key, one quota, one revocation point&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;name: &amp;lt;code&amp;gt;-&amp;lt;businessUnit&amp;gt;-&amp;lt;useCase&amp;gt;-&amp;lt;environment&amp;gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=enterprise-applications;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1315" y="216" width="590" height="106" as="geometry"/></mxCell><mxCell id="acc_sub" value="&lt;b&gt;2 · Subscription with keys&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;primary + secondary key — the api-key credential&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1315" y="334" width="590" height="70" as="geometry"/></mxCell><mxCell id="acc_pol" value="&lt;b&gt;3 · Rate limit + quota policy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;request-based for tool assets&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;token-based for LLM assets&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1315" y="416" width="590" height="84" as="geometry"/></mxCell><mxCell id="acc_kv" value="&lt;b&gt;4 · Key Vault secret storage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;useTargetAzureKeyVault: true beyond a lab&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1315" y="512" width="590" height="70" as="geometry"/></mxCell><mxCell id="acc_kv_p0" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1829" y="503" width="68" height="18" as="geometry"/></mxCell><mxCell id="acc_run" value="&lt;b&gt;Run when: a new business unit needs access  ·  Frequency: per consumer, asset, environment&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5C2D91;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1315" y="588" width="590" height="32" as="geometry"/></mxCell><mxCell id="e_pub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2.5;exitX=1;exitY=0.2115;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_pub" target="a_ep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_pub_l" value="publishes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="e_pub"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e_acc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#5C2D91;strokeWidth=2.5;exitX=0;exitY=0.2115;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_acc" target="a_ep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_acc_l" value="entitles" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#5C2D91;fontSize=10;fontStyle=1;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="e_acc"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e_rt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#107C10;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_ep" target="a_rt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_rt_l" value="proxies" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#107C10;fontSize=10;fontStyle=1;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="e_rt"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="g_paths" value="Asset types — the path-shape trap" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFCF3;strokeColor=#B7791F;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#B7791F;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="450" height="330" as="geometry"/></mxCell><mxCell id="paths" value="&lt;b&gt;mcp-from-api&lt;/b&gt; — tools already REST in API Management&lt;br&gt;→ {gateway}/mcp/&amp;lt;path&amp;gt;/mcp&lt;br&gt;&lt;br&gt;&lt;b&gt;mcp-existing&lt;/b&gt; — a running MCP server (this pattern)&lt;br&gt;→ {gateway}/mcp/&amp;lt;path&amp;gt; — dedicated backend&lt;br&gt;&lt;br&gt;&lt;b&gt;a2a&lt;/b&gt; — an agent&#x27;s A2A endpoint&lt;br&gt;→ {gateway}/agent/&amp;lt;path&amp;gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;404 on mcp-existing?&lt;/b&gt; Check you did not append /mcp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=top;arcSize=6;spacing=12;" vertex="1" parent="1"><mxGeometry x="55" y="726" width="420" height="258" as="geometry"/></mxCell><mxCell id="g_auth" value="Backend authType" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAF7FF;strokeColor=#5C2D91;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#5C2D91;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=app-registrations;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="510" y="670" width="470" height="330" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;none ★ default&lt;/b&gt; — Authorization passes through untouched (Identity Mode B)&lt;br&gt;&lt;br&gt;&lt;b&gt;managed-identity&lt;/b&gt; — API Management replaces Authorization (Identity Mode A)&lt;br&gt;&lt;br&gt;&lt;b&gt;api-key-header / api-key-bearer&lt;/b&gt; — inject a key for legacy servers with their own key&lt;br&gt;&lt;br&gt;&lt;b&gt;Backend URL must be https://&lt;/b&gt; — Phase 4 of the deployment adds TLS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=13;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=top;arcSize=6;spacing=12;" vertex="1" parent="1"><mxGeometry x="525" y="726" width="440" height="258" as="geometry"/></mxCell><mxCell id="g_cmp" value="Publish vs Access — at a glance" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAF9F8;strokeColor=#605E5C;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#605E5C;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="670" width="920" height="330" as="geometry"/></mxCell><mx