0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2_t" value="Bearer token issued&lt;br/&gt;(end-user or workload identity)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#323130;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="170" y="280" width="255" height="36" as="geometry"/></mxCell><mxCell id="m3" style="endArrow=classic;html=1;strokeColor=#A4262C;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="410" as="sourcePoint"/><mxPoint x="710" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3_t" value="&lt;b&gt;2&lt;/b&gt;  POST /mcp/&amp;lt;path&amp;gt; (initialize)&lt;br/&gt;api-key + Authorization: Bearer" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="175" y="370" width="520" height="36" as="geometry"/></mxCell><mxCell id="note_a" value="&lt;b&gt;On API Management&lt;/b&gt;&lt;br/&gt;security-handler: validate subscription key (optional per-product JWT)&lt;br/&gt;mcp-usage: emit inbound metric&lt;br/&gt;quota and rate-limit evaluation&lt;br/&gt;&lt;b&gt;Authorization header is NOT rewritten&lt;/b&gt; (backend authType = none)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#323130;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="580" y="440" width="470" height="100" as="geometry"/></mxCell><mxCell id="m4" style="endArrow=classic;html=1;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="590" as="sourcePoint"/><mxPoint x="985" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4_t" value="&lt;b&gt;3&lt;/b&gt;  Forward over TLS" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="720" y="550" width="255" height="36" as="geometry"/></mxCell><mxCell id="m5" style="endArrow=classic;html=1;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="660" as="sourcePoint"/><mxPoint x="1260" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5_t" value="&lt;b&gt;4&lt;/b&gt;  Streamable HTTP" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="995" y="620" width="255" height="36" as="geometry"/></mxCell><mxCell id="m6" style="endArrow=classic;html=1;strokeColor=#5C2D91;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="740" as="sourcePoint"/><mxPoint x="435" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6_t" value="&lt;b&gt;5&lt;/b&gt;  Validate bearer token" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="587" y="700" width="520" height="36" as="geometry"/></mxCell><mxCell id="m7" style="endArrow=classic;html=1;strokeColor=#5C2D91;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="810" as="sourcePoint"/><mxPoint x="1260" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7_t" value="Claims: real end-user identity" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#323130;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="587" y="770" width="520" height="36" as="geometry"/></mxCell><mxCell id="note_m" value="&lt;b&gt;On the MCP Gateway&lt;/b&gt;&lt;br/&gt;resource RBAC (mcp.admin / mcp.engineer)&lt;br/&gt;select healthy pod, bind session" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1130" y="840" width="360" height="70" as="geometry"/></mxCell><mxCell id="m8" style="endArrow=classic;html=1;strokeColor=#107C10;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="960" as="sourcePoint"/><mxPoint x="1535" y="960" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8_t" value="&lt;b&gt;6&lt;/b&gt;  Forward with&lt;br/&gt;X-Mcp-UserId / X-Mcp-Roles" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1270" y="920" width="255" height="36" as="geometry"/></mxCell><mxCell id="m9" style="endArrow=classic;html=1;strokeColor=#107C10;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1535" y="1030" as="sourcePoint"/><mxPoint x="1260" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9_t" value="Result&lt;br/&gt;(+ mcp-session-id)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#323130;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1270" y="990" width="255" height="36" as="geometry"/></mxCell><mxCell id="m10" style="endArrow=classic;html=1;strokeColor=#107C10;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="1100" as="sourcePoint"/><mxPoint x="710" y="1100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10_t" value="&lt;b&gt;7&lt;/b&gt;  Stream response&lt;br/&gt;(SSE, never buffered)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#323130;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="725" y="1060" width="520" height="36" as="geometry"/></mxCell><mxCell id="m11" style="endArrow=classic;html=1;strokeColor=#0078D4;strokeWidth=2;dashed=1;"