<mxfile host="Electron" agent="draw.io" version="26.0.0"><diagram id="request-path" name="Request path"><mxGraphModel dx="1700" dy="1360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="8" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="930" y="0" width="770" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Request path, end to end&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1620" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Two independent validations of the same bearer token: API Management governs entitlement, the MCP runtime governs identity." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1620" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Secure MCP Gateway Landing Zone  |  request path sequence  |  v2026-08-14  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="1620" height="20" as="geometry"/></mxCell><mxCell id="lane_c" value="&lt;b style=&quot;font-size:13px&quot;&gt;MCP client&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;interactive client or agent workload&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="80" as="geometry"/></mxCell><mxCell id="life_c" style="endArrow=classic;html=1;strokeColor=#A4262C;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="190" as="sourcePoint"/><mxPoint x="160" y="1190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lane_e" value="&lt;b style=&quot;font-size:13px&quot;&gt;Microsoft Entra ID&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;token issuer and validator&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="315" y="110" width="240" height="80" as="geometry"/></mxCell><mxCell id="life_e" style="endArrow=classic;html=1;strokeColor=#5C2D91;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="190" as="sourcePoint"/><mxPoint x="435" y="1190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lane_a" value="&lt;b style=&quot;font-size:13px&quot;&gt;API Management&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;governance edge&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;s