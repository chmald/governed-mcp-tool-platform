/></mxCell><mxCell id="g_obs" value="Observability and FinOps" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6FFF6;strokeColor=#107C10;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#107C10;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="670" y="410" width="600" height="360" as="geometry"/></mxCell><mxCell id="la" value="&lt;b&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;unified telemetry&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;across both planes&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=log-analytics;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="685" y="470" width="277" height="84" as="geometry"/></mxCell><mxCell id="ai" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;one request row per MCP call&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;api.type=Mcp · gen_ai.*&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=application-insights;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="978" y="470" width="277" height="84" as="geometry"/></mxCell><mxCell id="eh" value="&lt;b&gt;Event Hubs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;mcp-usage usage events&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=event-hubs;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="685" y="566" width="277" height="84" as="geometry"/></mxCell><mxCell id="la2" value="&lt;b&gt;Logic App&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;usage ingestion pipeline&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=logic-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="978" y="566" width="277" height="84" as="geometry"/></mxCell><mxCell id="cosmos" value="&lt;b&gt;Cosmos DB&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;chargeback / showback store&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=cosmos-db;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="685" y="662" width="277" height="84" as="geometry"/></mxCell><mxCell id="finops" value="&lt;b&gt;FinOps path&lt;/b&gt;&lt;br&gt;mcp-usage → Event Hub →&lt;br&gt;Logic App → Cosmos DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#C8C6C4;strokeWidth=1.5;fontSize=10.5;fontColor=#323130;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=8;" vertex="1" parent="1"><mxGeometry x="978" y="662" width="277" height="84" as="geometry"/></mxCell><mxCell id="g_net" value="Network and supply chain" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAF9F8;strokeColor=#605E5C;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#605E5C;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;spacingRight=10;fontFamily=Segoe UI;iconKey=virtual-network;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1300" y="410" width="600" height="360" as="geometry"/></mxCell><mxCell id="vnet" value="&lt;b&gt;Virtual networks + private endpoints&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;each plane brings its own default VNet&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;-EnablePrivateEndpoints restricts ACR + Cosmos DB&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=private-endpoint;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1315" y="470" width="570" height="84" as="geometry"/></mxCell><mxCell id="vnet_p0" value="OPT-IN" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1822" y="461" width="55" height="18" as="geometry"/></mxCell><mxCell id="netpol" value="&lt;b&gt;Kubernetes NetworkPolicy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;namespace adapter — default deny&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;only gateway / tool-gateway pods reach servers&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=nsg;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1315" y="566" width="570" height="84" as="geometry"/></mxCell><mxCell id="acr" value="&lt;b&gt;Azure Container Registry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;image source — the gateway does NOT build images&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;no image allow-listing upstream&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=58;spacingRight=6;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1315" y="662" width="570" height="84" as="geometry"/></mxCell><mxCell id="co_tls" value="&lt;b&gt;⚠ MANDATORY TLS HARDENING — Application Gateway (Decision #11, Phase 4)&lt;/b&gt;&lt;br&gt;&lt;br&gt;The upstream mcp-gateway Application Gateway listener is HTTP-only. Add TLS and an origin lock BEFORE pointing API Management at it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=14;fontColor=#A4262C;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="930" height="120" as="geometry"/></mxCell><mxCell id="co_sse" value="&lt;b&gt;⚠ SSE INBOUND-ONLY CONSTRAINT (Decision #7)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Never read context.Response.Body in any policy — it buffers the stream and breaks MCP. All policy is inbound only, so response-side PII de-anonymization and response content safety are not possible at the gateway; enforce them in the MCP server." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;fontSize=14;fontColor=#A4262C;fontFamily=Segoe UI;align=left;verticalAlign=middle;arcSize=6;spacing=16;" vertex="1" parent="1"><mxGeometry x="990" y="800" width="910" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>