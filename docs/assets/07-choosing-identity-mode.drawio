<mxfile host="Electron" agent="draw.io" version="26.0.0"><diagram id="07-choosing-identity-mode" name="Choosing an identity mode"><mxGraphModel dx="1640" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="902" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="902" y="0" width="738" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Choosing the identity mode&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1560" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Start at Mode B; leave it only for a stated reason, and record why" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1560" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Secure MCP Gateway Landing Zone | identity mode decision tree | v2026-08-14 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1560" height="20" as="geometry"/></mxCell><mxCell id="q1" value="Do consumers have a user or workload identity in your tenant?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="420" height="150" as="geometry"/></mxCell><mxCell id="q2" value="Can they obtain a token for api://CLIENT_ID?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="330" width="420" height="150" as="geometry"/></mxCell><mxCell id="q3" value="Must every call be metered and quota-governed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="420" height="150" as="geometry"/></mxCell><mxCell id="a" value="&lt;b style=&quot;font-size:13px&quot;&gt;Mode A&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;managed identity&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;iconKey=managed-identity;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="340" height="80" as="geometry"/></mxCell><mxCell id="a_pill" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="302" y="251" width="88" height="18" as="geometry"/></mxCell><mxCell id="b" value="&lt;b style=&quot;font-size:13px&quot;&gt;Mode B - passthrough&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;caller token reaches the runtime&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F9F1;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="540" y="750" width="420" height="80" as="geometry"/></mxCell><mxCell id="b_pill" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="886" y="741" width="79" height="18" as="geometry"/></mxCell><mxCell id="c" value="&lt;b style=&quot;font-size:13px&quot;&gt;Mode C - split plane&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;interactive devs go direct&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1160" y="575" width="380" height="80" as="geometry"/></mxCell><mxCell id="c_pill" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1462" y="566" width="88" height="18" as="geometry"/></mxCell><mxCell id="y1" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#107C10;strokeWidth=2;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=2;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="q1" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="y2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#107C10;strokeWidth=2;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q2" target="q3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=2;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="q2" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="y3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#107C10;strokeWidth=3;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q3" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n3" value="No - interactive&lt;br&gt;devs may go direct" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=2;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q3" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="guide" value="&lt;b&gt;Practical guidance&lt;/b&gt;&lt;br&gt;&lt;br&gt;- &lt;b&gt;Start at Mode B.&lt;/b&gt; It preserves the most information and closes off the fewest future options.&lt;br&gt;&lt;br&gt;- &lt;b&gt;Move to Mode A&lt;/b&gt; only for a specific machine-workload asset, and record why.&lt;br&gt;&lt;br&gt;- &lt;b&gt;Reach for Mode C&lt;/b&gt; only when interactive developer experience outweighs universal metering.&lt;br&gt;&lt;br&gt;- &lt;b&gt;Modes can differ per published asset&lt;/b&gt; - they are a property of the backend declaration, not the platform." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEECF9;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#323130;align=left;verticalAlign=middle;arcSize=6;spacing=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="540" height="330" as="geometry"/></mxCell><mxCell id="legend_lbl" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="865" width="60" height="18" as="geometry"/></mxCell><mxCell id="legend_p0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="110" y="865" width="79" height="18" as="geometry"/></mxCell><mxCell id="legend_t0" value="recommended starting point" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="195" y="864" width="220" height="20" as="geometry"/></mxCell><mxCell id="legend_p1" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="425" y="865" width="88" height="18" as="geometry"/></mxCell><mxCell id="legend_t1" value="needs a stated reason" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="519" y="864" width="220" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>