<mxfile host="Electron" agent="draw.io" version="26.0.0">
  <diagram id="secure-mcp-gateway-identity-flow" name="Identity &amp; Token Flow">
    <mxGraphModel dx="2000" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1342" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Identity &amp; Token Flow — Mode B: Caller-Token Passthrough (default)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two independent authorization systems, two credentials, one unmodified token — entitlement and identity are separate questions answered by separate planes" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#605E5C;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1820" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lane_client" value="MCP client" style="shape=label;rounded=0;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;iconKey=dev-console;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#A4262C;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#A4262C;strokeWidth=2;fontFamily=Segoe UI;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lane_entra" value="Microsoft Entra ID" style="shape=label;rounded=0;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;iconKey=entra-id;whiteSpace=wrap;html=1;fillColor=#F3EFF9;strokeColor=#5C2D91;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lane_apim" value="API Management&#10;(governance edge)" style="shape=label;rounded=0;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;iconKey=api-management;whiteSpace=wrap;html=1;fillColor=#DEECF9;strokeColor=#0078D4;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lane_mgw" value="MCP Gateway&#10;(runtime)" style="shape=label;rounded=0;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;iconKey=aks;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lane_pod" value="MCP server pod" style="shape=label;rounded=0;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;iconKey=code;whiteSpace=wrap;html=1;fillColor=#F3F9F1;strokeColor=#107C10;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="1040" y="100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ll1" style="endArrow=none;html=1;strokeColor=#A4262C;strokeWidth=1;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="150" as="sourcePoint" />
            <mxPoint x="160" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll2" style="endArrow=none;html=1;strokeColor=#5C2D91;strokeWidth=1;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="150" as="sourcePoint" />
            <mxPoint x="400" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll3" style="endArrow=none;html=1;strokeColor=#0078D4;strokeWidth=1;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="150" as="sourcePoint" />
            <mxPoint x="650" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll4" style="endArrow=none;html=1;strokeColor=#107C10;strokeWidth=1;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="150" as="sourcePoint" />
            <mxPoint x="900" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll5" style="endArrow=none;html=1;strokeColor=#107C10;strokeWidth=1;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="150" as="sourcePoint" />
            <mxPoint x="1140" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s1" value="1  Acquire token for audience  api://&amp;lt;CLIENT_ID&amp;gt;" style="endArrow=classic;html=1;strokeColor=#5C2D91;strokeWidth=2;fontSize=11;verticalAlign=bottom;align=center" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="200" as="sourcePoint" />
            <mxPoint x="400" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s1b" value="Bearer token issued  (aud = api://&amp;lt;CLIENT_ID&amp;gt;)" style="endArrow=classic;html=1;strokeColor=#5C2D91;strokeWidth=2;dashed=1;fontSize=11;verticalAlign=bottom;align=center" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="245" as="sourcePoint" />
            <mxPoint x="160" y="245" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2" value="2  Call published endpoint with BOTH credentials&#10;api-key: &amp;lt;subscription key&amp;gt;   +   Authorization: Bearer &amp;lt;token&amp;gt;" style="endArrow=classic;html=1;strokeColor=#A4262C;strokeWidth=3;fontSize=11;verticalAlign=bottom;align=center;fontStyle=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="320" as="sourcePoint" />
            <mxPoint x="650" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3" value="3  security-handler → validate subscription key&#10;mcp-usage → emit inbound metric&#10;evaluate quota + rate limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEECF9;strokeColor=#0078D4;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=2;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="530" y="350" width="250" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s4box" value="4  CRUX OF THE DESIGN&#10;backend authType = none&#10;→ API Management injects NO credential&#10;→ the caller's Authorization header is FORWARDED UNMODIFIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;fontSize=11;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=3;fontStyle=1;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="430" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4  Forward — token intact" style="endArrow=classic;html=1;strokeColor=#B7791F;strokeWidth=4;fontSize=11;verticalAlign=bottom;align=center;fontStyle=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="560" as="sourcePoint" />
            <mxPoint x="900" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s5" value="5  Validate the SAME token" style="endArrow=classic;html=1;strokeColor=#5C2D91;strokeWidth=2;fontSize=11;verticalAlign=bottom;align=center" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="620" as="sourcePoint" />
            <mxPoint x="400" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s5b" value="Claims — the REAL end-user principal" style="endArrow=classic;html=1;strokeColor=#5C2D91;strokeWidth=2;dashed=1;fontSize=11;verticalAlign=bottom;align=center" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="665" as="sourcePoint" />
            <mxPoint x="900" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s6" value="6  Resource RBAC:  mcp.admin / mcp.engineer&#10;Scope session to (principal, adapter, session id)&#10;→ session id cannot be replayed by another caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=2;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="790" y="690" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7  Forward as  X-Mcp-UserId / X-Mcp-Roles" style="endArrow=classic;html=1;strokeColor=#107C10;strokeWidth=3;fontSize=11;verticalAlign=bottom;align=center" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="800" as="sourcePoint" />
            <mxPoint x="1140" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s7note" value="Client-supplied X-Mcp-* headers are STRIPPED first — identity cannot be forged.&#10;The raw Authorization header is NOT forwarded to the pod (blast-radius reduction).&#10;An internal shared secret gates gateway → tool-router trust — set it to a strong random value." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=6;strokeWidth=2;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1180" y="770" width="560" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="8  Response streams back over SSE — NEVER buffered" style="endArrow=classic;html=1;strokeColor=#A4262C;strokeWidth=3;dashed=1;fontSize=11;verticalAlign=bottom;align=center;fontStyle=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="900" as="sourcePoint" />
            <mxPoint x="160" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s8note" value="Any policy that reads the response body buffers the stream and breaks MCP.&#10;This is why all policy is INBOUND ONLY, and why response-side PII de-anonymization&#10;and response content safety are architecturally impossible at the gateway." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;fontSize=10;fontColor=#A4262C;align=left;verticalAlign=top;arcSize=6;strokeWidth=2;spacing=6;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1180" y="880" width="560" height="66" as="geometry" />
        </mxCell>
        <mxCell id="creds" value="TWO CREDENTIALS, TWO QUESTIONS&#10;&#10;api-key  →  WHICH BUSINESS UNIT?  WHAT QUOTA?&#10;         Answered by API Management (Access Contract product + subscription)&#10;         The subscription key alone authenticates at the gateway, then FAILS at the runtime.&#10;&#10;Authorization: Bearer  →  WHICH PRINCIPAL?  WHAT MAY THEY REACH?&#10;         Answered by the MCP runtime (Entra claims + resource RBAC)&#10;         The bearer token alone is REJECTED at the gateway.&#10;&#10;Both are required by design. Neither plane trusts the other's decision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#323130;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=3;spacing=10;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="60" y="1040" width="820" height="210" as="geometry" />
        </mxCell>
        <mxCell id="modes_hdr" value="THE THREE IDENTITY MODES" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#323130;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="920" y="1040" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="mode_a" value="A — Managed identity&#10;backend authType: managed-identity&#10;&#10;Runtime sees API Management's service principal.&#10;Runtime RBAC collapses to one caller.&#10;Audit shows one principal, forever.&#10;&#10;CORRECT for machine workloads with no user context." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#605E5C;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=2;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="920" y="1076" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="mode_b" value="B — Caller-token passthrough   ★ DEFAULT&#10;backend authType: none&#10;&#10;Runtime sees the REAL end user or workload.&#10;Runtime RBAC fully preserved.&#10;Per-principal session scoping is meaningful.&#10;&#10;Requires token audience api://&amp;lt;CLIENT_ID&amp;gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=3;spacing=8;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1076" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="mode_c" value="C — Split plane&#10;&#10;Machine traffic → governed via API Management.&#10;Interactive clients → direct to the runtime using&#10;OAuth discovery (RFC 9728 protected resource metadata).&#10;&#10;CAUTION: the direct route bypasses quota and metering." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#605E5C;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=2;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1560" y="1076" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="confused" value="Why B is the default:  giving the gateway a managed identity replaces the caller's Authorization header, so the runtime only ever sees the gateway.&#10;That is a textbook CONFUSED DEPUTY — the gateway acts on behalf of callers whose identity it has discarded. Mode B makes that a deliberate choice, not an accident." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;fontSize=11;fontColor=#A4262C;align=left;verticalAlign=middle;arcSize=8;strokeWidth=2;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="60" y="960" width="1800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mode_b__tag0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1469" y="1067" width="61" height="18" as="geometry" />
        </mxCell>
        <mxCell id="rs_bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="-6" width="1001" height="6" as="geometry" />
        </mxCell>
        <mxCell id="rs_bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1041" y="-6" width="819" height="6" as="geometry" />
        </mxCell>
        <mxCell id="rs_legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="1272" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="rs_lg_DEFAULT" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="110" y="1273" width="61" height="18" as="geometry" />
        </mxCell>
        <mxCell id="rs_lgt_DEFAULT" value="the path the demo takes by default" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="177" y="1272" width="248" height="20" as="geometry" />
        </mxCell>
        <mxCell id="rs_footer" value="Secure MCP Gateway Landing Zone | Mode B identity and token flow | v2026-08-14 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="1302" width="1820" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>