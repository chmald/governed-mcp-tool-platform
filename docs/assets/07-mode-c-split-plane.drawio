<mxfile host="Electron" agent="draw.io" version="26.0.0"><diagram id="07-mode-c-split-plane" name="Mode C split plane"><mxGraphModel dx="1800" dy="660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="990" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="990" y="0" width="810" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Mode C: two routes to the same runtime&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Machine workloads take the governed route; interactive developers sign in directly" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1720" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Secure MCP Gateway Landing Zone | Mode C split-plane routing | v2026-08-14 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1720" height="20" as="geometry"/></mxCell><mxCell id="lg" value="Governed route - metered" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#DEECF9;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;spacingTop=8;imageWidth=28;imageHeigh