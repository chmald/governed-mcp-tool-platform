<mxfile host="Electron" agent="draw.io" version="26.0.0"><diagram id="07-naive-managed-identity" name="Naive managed-identity integration"><mxGraphModel dx="1640" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="902" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="902" y="0" width="738" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;The naive integration loses the user&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1560" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="One replaced Authorization header turns the gateway into a confused deputy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1560" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Secure MCP Gateway Landing Zone | Mode A managed-identity trade-off | v2026-08-14 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1560" height="20" as="geometry"/></mxCell><mxCell id="user" value="&lt;b style=&quot;font-size:13px&quot;&gt;End user&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;subscription key plus user token&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#