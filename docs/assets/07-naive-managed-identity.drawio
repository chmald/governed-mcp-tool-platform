="1" parent="1" source="user" target="apim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="2 Call with APIM's&lt;br&gt;own token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=3;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="apim" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0;exitY=0.8;entryX=1;entryY=0.8;dashed=1;" edge="1" parent="1" source="mcp" target="apim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0;exitY=0.8;entryX=1;entryY=0.8;dashed=1;" edge="1" parent="1" source="apim" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_apim" value="&lt;b&gt;Authorization header is REPLACED.&lt;/b&gt;&lt;br&gt;The caller's token never reaches the runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#323130;align=left;verticalAlign=middle;arcSize=6;spacing=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="380" height="80" as="geometry"/></mxCell><mxCell id="n_mcp" value="&lt;b&gt;The runtime sees APIM's service principal.&lt;/b&gt;&lt;br&gt;The user is gone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=2;fontSize=12;fontColor=#323130;align=left;verticalAlign=middle;arcSize=6;spacing=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1230" y="250" width="380" height="80" as="geometry"/></mxCell><mxCell id="cons" value="Every consequence follows from that one replaced header" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#A4262C;fontFamily=Segoe UI;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=activity-log;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1560" height="180" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Audit logs&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;one principal for every call, forever&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;iconKey=activity-log;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="365" height="80" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Runtime RBAC&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;cannot discriminate between users&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;iconKey=entra-roles;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="445" y="440" width="365" height="80" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Session scoping&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;all sessions share one principal&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;iconKey=users;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="830" y="440" width="365" height="80" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Tool identity&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;a tool cannot know who the user is&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1215" y="440" width="365" height="80" as="geometry"/></mxCell><mxCell id="legend_lbl" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="60" height="18" as="geometry"/></mxCell><mxCell id="legend_p0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="110" y="580" width="79" height="18" as="geometry"/></mxCell><mxCell id="legend_t0" value="Mode A is a valid choice for machine traffic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSi