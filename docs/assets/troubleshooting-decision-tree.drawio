        <mxCell id="dm33" value="#18 404 on the MCP path?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="960" y="320" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="tl34" value="&lt;b&gt;Wrong path shape&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;mcp-existing and mcp-from-api expose different paths&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1320" y="320" width="270" height="140" as="geometry"/></mxCell>
