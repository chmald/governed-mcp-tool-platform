        <mxCell id="tl8" value="&lt;b&gt;#19 Wrong tenant&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Ambient az or azd account drifted. az login --tenant, az account set, then azd env set AZURE_TENANT_ID and AZURE_SUBSCRIPTION_ID&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=2.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="380" height="150" as="geometry"/></mxCell>
