        <mxCell id="t4" value="Page 1 triages. Pages 2 to 5 list each symptom as condition seen, likely cause and fix. #N matches the symptom number in docs/05-troubleshooting.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="26" as="geometry"/></mxCell>
