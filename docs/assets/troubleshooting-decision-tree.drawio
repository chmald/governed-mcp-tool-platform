        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#107C10;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl27" target="tl28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="dm33" value="#5 Foundry model or TPM deployment fails?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="960" y="320" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="tl34" value="&lt;b&gt;Model or quota unavailable&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Model not offered in the region, or TPM quota is too low&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=azure-openai;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1320" y="320" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="tl35" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Check the region, request quota, or pick a smaller model&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=cost-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1620" y="320" width="250" height="140" as="geometry"/></mxCell>
