        <mxCell id="tl13" value="&lt;b&gt;Governance plane: azd up&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Symptoms 1 to 6: transient failure, role assignment, providers, APIM SKU region, Foundry TPM, cost&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="760" height="110" as="geometry"/></mxCell>
        <mxCell id="p14" value="PAGE 2" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1788" y="111" width="60" height="18" as="geometry"/></mxCell>
