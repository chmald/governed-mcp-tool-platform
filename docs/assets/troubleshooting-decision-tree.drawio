        <mxCell id="e10l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;" vertex="1" connectable="0" parent="e10"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#107C10;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl6" target="tl7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="dm12" value="#22 Prompts are missing?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="tl13" value="&lt;b&gt;APIM limit for external servers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Tools and resources are supported, prompts are not&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="tl14" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;No gateway-side fix. Plan around tools and resources only&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="250" height="140" as="geometry"/></mxCell>
