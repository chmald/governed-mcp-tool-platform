        <mxCell id="t36" value="Secure MCP Gateway Landing Zone | Troubleshooting decision tree | v2026-08-14 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="1820" height="20" as="geometry"/></mxCell>
