        <mxCell id="tl16" value="&lt;b&gt;MCP runtime on AKS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Symptoms 7 to 13: 403, TLS, session affinity, 500s, adapter, Cosmos, Tool Gateway Router&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008272;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=aks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1100" y="260" width="760" height="110" as="geometry"/></mxCell>
        <mxCell id="p17" value="PAGE 3" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#008272;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1788" y="251" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#008272;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dm7" target="tl16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="tl19" value="&lt;b&gt;APIM edge, publish and client request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Symptoms 14 to 18 and 20: subscription key, hangs, circuit breaker, audience, 404, streaming&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=application-gateway;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="760" height="110" as="geometry"/></mxCell>
        <mxCell id="p20" value="PAGE 4" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1788" y="391" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5C2D91;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dm7" target="tl19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="tl22" value="&lt;b&gt;Capabilities and telemetry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Symptoms 21 to 26: header forwarding, prompts, workspace scope, onboarding, telemetry, payload logging&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1100" y="540" width="760" height="110" as="geometry"/></mxCell>
        <mxCell id="p23" value="PAGE 5" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1788" y="531" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CA5010;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dm7" target="tl22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="tl25" value="&lt;b&gt;Still stuck? Escalate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Capture the exact command and full error, pinned SHA, region and offer type, redacted az account show, kubectl describe and logs for pod issues, and whether it reproduces on a fresh deployment. File governance issues with Azure-Samples/ai-hub-gateway-solution-accelerator and runtime issues with microsoft/mcp-gateway (check issue #98 first). Redact GUIDs, keys and tokens.&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=2;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="760" height="160" as="geometry"/></mxCell>
        <mxCell id="p26" value="ESCALATE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1774" y="691" width="74" height="18" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#605E5C;strokeWidth=2;endArrow=classic;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dm7" target="tl25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="780"/></Array></mxGeometry></mxCell>
        <mxCell id="e27l" value="no match" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#605E5C;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;" vertex="1" connectable="0" parent="e27"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="b28" value="&lt;b&gt;How to read pages 2 to 5&lt;/b&gt;&lt;br&gt;Each row is independent. Find the condition you observe, follow Yes to the likely cause and its check, then to the fix. If no row matches, come back here and escalate." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="720" height="110" as="geometry"/></mxCell>
        <mxCell id="t29" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="p30" value="PAGE N" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="104" y="891" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="t31" value="symptom list for that stage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="170" y="890" width="163" height="20" as="geometry"/></mxCell>
        <mxCell id="p32" value="CROSS-CUTTING" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#A4262C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="351" y="891" width="109" height="18" as="geometry"/></mxCell>
        <mxCell id="t33" value="applies to every stage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="466" y="890" width="135" height="20" as="geometry"/></mxCell>
        <mxCell id="p34" value="ESCALATE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="619" y="891" width="74" height="18" as="geometry"/></mxCell>
