        <mxCell id="t3" value="&lt;b&gt;APIM edge, publish and client request (symptoms 14 to 18 and 20)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="Failures after the asset is published through API Management. Keep MCP policies inbound-only. Source: docs/05-troubleshooting.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="26" as="geometry"/></mxCell>
        <mxCell id="dm5" value="#14 401 missing subscription key?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="tl6" value="&lt;b&gt;Wrong header or internal hop&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Ocp-Apim-Subscription-Key vs api-key, or the mcp-from-api internal hop&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="tl7" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Send the right header. For mcp-from-api set subscriptionRequired false or forwardSubscriptionKeyToSource with x-mcp-sub-key&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="p8" value="CAUSE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="598" y="121" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="p9" value="FIX" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="878" y="121" width="60" height="18" as="geometry"/></mxCell>
