  <diagram id="page2" name="2 Governance plane">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="770" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="acc1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1045" height="6" as="geometry"/></mxCell>
        <mxCell id="acc2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1045" y="0" width="855" height="6" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;Governance plane: azd up and tenant prerequisites (symptoms 1 to 6)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="Plane 1 deployment failures. Rule out the prerequisite causes in #2 to #5 before treating #1 as transient. Source: docs/05-troubleshooting.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="26" as="geometry"/></mxCell>
        <mxCell id="dm5" value="#1 azd up fails with an error that looks transient?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="tl6" value="&lt;b&gt;Transient or hidden prerequisite&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Often a prerequisite failure in disguise. Rule out #2 to #5 first&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="tl7" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Re-run azd up. If it repeats, work through #2 to #5 in order&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=powershell;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="p8" value="CAUSE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="598" y="121" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="p9" value="FIX" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="878" y="121" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="dm5" target="tl6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;" vertex="1" connectable="0" parent="e10"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#107C10;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl6" target="tl7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="dm12" value="#2 Role assignment fails during azd up?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="tl13" value="&lt;b&gt;Insufficient RBAC&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;The identity cannot create role assignments&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=entra-roles;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="tl14" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Use Owner, or Contributor plus User Access Administrator (docs/02 section 3)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="p15" value="CAUSE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="598" y="311" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="p16" value="FIX" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="878" y="311" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="dm12" target="tl13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e17l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;" vertex="1" connectable="0" parent="e17"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#107C10;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="tl13" target="tl14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="dm19" value="#3 A resource provider is not registered?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="tl20" value="&lt;b&gt;Provider not registered&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Plane 1 needs about 24 providers. The docs/02 loop registers 17&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="400" y="510" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="tl21" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;az provider register for the missing namespace, then poll until Registered&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=powershell;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="700" y="510" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="p22" value="CAUSE" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="598" y="501" width="60" height="18" as="geometry"/></mxCell>
        <mxCell id="p23" value="FIX" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="878" y="501" width="60" height="18" as="geometry"/></mxCell>
