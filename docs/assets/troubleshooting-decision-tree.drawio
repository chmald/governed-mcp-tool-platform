        <mxCell id="dm12" value="#15 Calls hang or the response truncates?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="tl13" value="&lt;b&gt;Policy reads the response body&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;A policy touches context.Response.Body, which buffers the stream&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=event-hubs;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="270" height="140" as="geometry"/></mxCell>
